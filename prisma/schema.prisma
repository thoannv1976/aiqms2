// Prisma schema — Hệ thống Kiểm định CTĐT (AUN-QA, đa tiêu chuẩn)
// Quy ước (xem CLAUDE.md):
//   - Mọi bảng nghiệp vụ có: id, tenantId, createdAt, updatedAt, createdBy,
//     updatedBy, status, deletedAt (soft-delete).
//   - Bảng nghiệp vụ phải nằm trong TENANT_SCOPED_MODELS ở
//     src/lib/prisma/tenant-models.ts để được lọc tenant tự động.
//   - Mỗi thay đổi schema = đúng một migration. Không sửa DB tay.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Registry tenant (KHÔNG tenant-scoped) ──────────────────────────────────
// Đăng ký các trường đại học dùng nền tảng. Billing theo thời gian: validUntil.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // subdomain: <slug>.localhost
  name      String
  status    String   @default("active") // active | suspended
  validUntil DateTime? // billing: hết hạn -> middleware chặn 403
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs   AuditLog[]
  users       User[]
  userRoles   UserRole[]
  faculties   Faculty[]
  programmes  Programme[]
  programmeVersions ProgrammeVersion[]
  peos        ProgrammeObjective[]
  plos        ProgrammeLearningOutcome[]
  courses     Course[]
  clos        CourseLearningOutcome[]
  ploCourseMappings PloCourseMapping[]
  cloPloMappings    CloPloMapping[]
  assessmentCycles  AssessmentCycle[]
  sars              SelfAssessmentReport[]
  sarResponses      SarCriterionResponse[]
  sarComments       SarComment[]
  internalReviews   InternalReview[]
  internalReviewScores InternalReviewScore[]
  evidences            Evidence[]
  evidenceFiles        EvidenceFile[]
  evidenceLinks        EvidenceLink[]
  evidenceCriteria     EvidenceCriterionMapping[]
  evidenceRequirements EvidenceRequirementMapping[]
  evidenceVerifications EvidenceVerificationLog[]
  tasks                Task[]
  taskComments         TaskComment[]
  improvementPlans     ImprovementPlan[]
  improvementActions   ImprovementAction[]
  improvementKpis      ImprovementKpi[]
  improvementProgress  ImprovementProgressLog[]
  exportJobs           ExportJob[]
  aiSettings           AiSettings?
  aiRequests           AiRequest[]
  aiDrafts             AiGeneratedDraft[]
  stakeholderGroups    StakeholderGroup[]
  surveys              Survey[]
  surveyQuestions      SurveyQuestion[]
  surveyResponses      SurveyResponse[]
  academicStaff        AcademicStaff[]
  studentServices      StudentService[]
  facilities2          Facility[]
  outcomeMetrics       OutcomeMetric[]
  departments Department[]

  @@map("tenants")
}

// ─── RBAC khai báo bằng dữ liệu (GLOBAL — không tenant-scoped) ───────────────
// Permission/Role là catalog dùng chung mọi tenant; assignment (UserRole) mới theo tenant.
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // ví dụ "user.manage", "sar.write"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ví dụ "qa_office", "lecturer"
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Người dùng (tenant-scoped) ─────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  isSuperAdmin Boolean   @default(false) // xuyên tenant (đường đi riêng)
  status       String    @default("active") // active | disabled
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime? // soft-delete

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  facultyId String? // phạm vi: vai trò gắn với khoa cụ thể (tùy chọn)
  createdAt DateTime @default(now())
  createdBy String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, facultyId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

// ─── Đơn vị (tenant-scoped) ─────────────────────────────────────────────────
model Faculty {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("faculties")
}

model Department {
  id        String    @id @default(cuid())
  tenantId  String
  facultyId String
  code      String
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, facultyId])
  @@index([tenantId, deletedAt])
  @@map("departments")
}

// ─── Audit log (tenant-scoped) ──────────────────────────────────────────────
// Ghi mọi thao tác quan trọng: tạo/sửa/xóa/duyệt/chấm điểm/thao tác AI.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String // ví dụ: "tenant.create", "sar.approve", "ai.draft"
  entity    String // tên thực thể: "Tenant", "SelfAssessmentReport", ...
  entityId  String?
  actorId   String? // user id thực hiện (null = hệ thống/seed)
  meta      Json? // dữ liệu phụ (diff, ghi chú...)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// P2 — Bộ tiêu chuẩn kiểm định (GLOBAL, data-driven — xương sống đa-tiêu-chuẩn)
// KHÔNG tenant-scoped: catalog dùng chung; thêm chuẩn mới = nạp dữ liệu, không sửa
// code lõi. Chỉ super-admin (platform) được sửa.
// ════════════════════════════════════════════════════════════════════════════
model AccreditationStandard {
  id          String   @id @default(cuid())
  code        String   @unique // "AUN-QA", "MOET", ...
  name        String
  description String?
  level       String   @default("programme") // programme | institution
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions StandardVersion[]

  @@map("accreditation_standards")
}

model StandardVersion {
  id         String   @id @default(cuid())
  standardId String
  version    String // "4.0"
  name       String?
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  standard     AccreditationStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  criteria     Criterion[]
  ratingScales RatingScale[]

  @@unique([standardId, version])
  @@map("standard_versions")
}

model Criterion {
  id                String   @id @default(cuid())
  standardVersionId String
  code              String // "C1".."C8"
  order             Int
  titleVi           String
  titleEn           String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  version            StandardVersion     @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  requirements       Requirement[]
  suggestedEvidences SuggestedEvidence[]

  @@unique([standardVersionId, code])
  @@index([standardVersionId, order])
  @@map("criteria")
}

model Requirement {
  id          String   @id @default(cuid())
  criterionId String
  code        String // "1.1"
  order       Int
  title       String
  description String?
  guidance    String? // câu hỏi định hướng tự đánh giá
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterion  Criterion   @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  indicators Indicator[]

  @@unique([criterionId, code])
  @@index([criterionId, order])
  @@map("requirements")
}

model Indicator {
  id            String   @id @default(cuid())
  requirementId String
  code          String
  description   String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, code])
  @@map("indicators")
}

model RatingScale {
  id                String   @id @default(cuid())
  standardVersionId String
  level             Int // 1..7 (thang AUN-QA)
  labelVi           String
  labelEn           String?
  description       String?

  version StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)

  @@unique([standardVersionId, level])
  @@map("rating_scales")
}

model SuggestedEvidence {
  id          String  @id @default(cuid())
  criterionId String
  description String
  type        String?

  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("suggested_evidences")
}

// ════════════════════════════════════════════════════════════════════════════
// P3 — Chương trình đào tạo + OBE (tenant-scoped)
// CTĐT đa phiên bản, PEO/PLO/CLO, ma trận liên kết, cảnh báo độ phủ.
// ════════════════════════════════════════════════════════════════════════════
model Programme {
  id           String    @id @default(cuid())
  tenantId     String
  facultyId    String?
  code         String
  name         String
  nameEn       String?
  level        String    @default("bachelor") // bachelor | master | doctor
  totalCredits Int?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions ProgrammeVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@index([tenantId, facultyId])
  @@map("programmes")
}

model ProgrammeVersion {
  id                    String    @id @default(cuid())
  tenantId              String
  programmeId           String
  version               String
  year                  Int?
  status                String    @default("draft") // draft | active | archived
  educationalPhilosophy String?
  description           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme  Programme              @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  peos       ProgrammeObjective[]
  plos       ProgrammeLearningOutcome[]

  @@unique([tenantId, programmeId, version])
  @@index([tenantId, programmeId])
  @@map("programme_versions")
}

model ProgrammeObjective {
  id                 String   @id @default(cuid())
  tenantId           String
  programmeVersionId String
  code               String // "PEO1"
  description        String
  order              Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version ProgrammeVersion @relation(fields: [programmeVersionId], references: [id], onDelete: Cascade)

  @@unique([programmeVersionId, code])
  @@index([tenantId, programmeVersionId])
  @@map("programme_objectives")
}

model ProgrammeLearningOutcome {
  id                 String   @id @default(cuid())
  tenantId           String
  programmeVersionId String
  code               String // "PLO1"
  description        String
  order              Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version        ProgrammeVersion   @relation(fields: [programmeVersionId], references: [id], onDelete: Cascade)
  courseMappings PloCourseMapping[]
  cloMappings    CloPloMapping[]

  @@unique([programmeVersionId, code])
  @@index([tenantId, programmeVersionId])
  @@map("programme_learning_outcomes")
}

model Course {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  name      String
  credits   Int       @default(3)
  status    String    @default("active")
  // Đề cương học phần (spec 4.7)
  description       String?
  prerequisites     String?
  content           String? // nội dung giảng dạy
  teachingMethods   String? // phương pháp giảng dạy
  assessmentMethods String? // phương pháp đánh giá
  materials         String? // tài liệu học tập
  rubric            String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clos     CourseLearningOutcome[]
  ploMaps  PloCourseMapping[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("courses")
}

model CourseLearningOutcome {
  id          String   @id @default(cuid())
  tenantId    String
  courseId    String
  code        String // "CLO1"
  description String
  order       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ploMappings CloPloMapping[]

  @@unique([courseId, code])
  @@index([tenantId, courseId])
  @@map("course_learning_outcomes")
}

// Ma trận PLO-học phần (độ phủ: học phần đóng góp cho PLO ở mức I/R/M).
model PloCourseMapping {
  id        String   @id @default(cuid())
  tenantId  String
  ploId     String
  courseId  String
  level     String   @default("I") // I (Introduce) | R (Reinforce) | M (Master)
  createdAt DateTime @default(now())

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plo    ProgrammeLearningOutcome @relation(fields: [ploId], references: [id], onDelete: Cascade)
  course Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([ploId, courseId])
  @@index([tenantId, ploId])
  @@index([tenantId, courseId])
  @@map("plo_course_mappings")
}

// Ma trận CLO-PLO.
model CloPloMapping {
  id        String   @id @default(cuid())
  tenantId  String
  cloId     String
  ploId     String
  createdAt DateTime @default(now())

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clo    CourseLearningOutcome    @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo    ProgrammeLearningOutcome @relation(fields: [ploId], references: [id], onDelete: Cascade)

  @@unique([cloId, ploId])
  @@index([tenantId, cloId])
  @@index([tenantId, ploId])
  @@map("clo_plo_mappings")
}

// ════════════════════════════════════════════════════════════════════════════
// P4 — Đợt tự đánh giá + SAR (tenant-scoped) — module trung tâm
// ════════════════════════════════════════════════════════════════════════════
model AssessmentCycle {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  year              Int?
  standardVersionId String // bộ tiêu chuẩn áp dụng (global)
  status            String    @default("open") // open | closed
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reports SelfAssessmentReport[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("assessment_cycles")
}

model SelfAssessmentReport {
  id                 String    @id @default(cuid())
  tenantId           String
  assessmentCycleId  String
  programmeVersionId String
  standardVersionId  String
  title              String
  status             String    @default("not_started") // vòng đời SAR (state machine)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle     AssessmentCycle         @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  responses SarCriterionResponse[]
  comments  SarComment[]
  reviews   InternalReview[]

  @@index([tenantId, status])
  @@index([tenantId, assessmentCycleId])
  @@index([tenantId, deletedAt])
  @@map("self_assessment_reports")
}

model SarCriterionResponse {
  id              String   @id @default(cuid())
  tenantId        String
  sarId           String
  criterionId     String // tham chiếu Criterion (global)
  currentState    String? // mô tả hiện trạng
  analysis        String? // phân tích mức độ đáp ứng
  strengths       String? // điểm mạnh
  weaknesses      String? // điểm tồn tại
  improvementDone String? // hoạt động cải tiến đã thực hiện
  improvementPlan String? // kế hoạch cải tiến tiếp theo
  selfScore       Int? // điểm tự đánh giá (theo thang 7 mức)
  reviewerComment String?
  status          String   @default("not_started") // not_started|in_progress|needs_more|completed|reviewed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sar    SelfAssessmentReport @relation(fields: [sarId], references: [id], onDelete: Cascade)

  @@unique([sarId, criterionId])
  @@index([tenantId, sarId])
  @@map("sar_criterion_responses")
}

model SarComment {
  id          String   @id @default(cuid())
  tenantId    String
  sarId       String
  criterionId String?
  authorId    String?
  body        String
  createdAt   DateTime @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sar    SelfAssessmentReport @relation(fields: [sarId], references: [id], onDelete: Cascade)

  @@index([tenantId, sarId])
  @@map("sar_comments")
}

model InternalReview {
  id        String   @id @default(cuid())
  tenantId  String
  sarId     String
  reviewerId String
  status    String   @default("in_progress") // in_progress | submitted
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sar    SelfAssessmentReport    @relation(fields: [sarId], references: [id], onDelete: Cascade)
  scores InternalReviewScore[]

  @@unique([sarId, reviewerId])
  @@index([tenantId, sarId])
  @@map("internal_reviews")
}

model InternalReviewScore {
  id             String   @id @default(cuid())
  tenantId       String
  internalReviewId String
  criterionId    String
  score          Int
  strengths      String?
  weaknesses     String?
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review InternalReview @relation(fields: [internalReviewId], references: [id], onDelete: Cascade)

  @@unique([internalReviewId, criterionId])
  @@index([tenantId, internalReviewId])
  @@map("internal_review_scores")
}

// ════════════════════════════════════════════════════════════════════════════
// P5 — Kho minh chứng (tenant-scoped). File qua lớp Storage (không ghi đĩa container).
// Một minh chứng liên kết nhiều tiêu chí/yêu cầu; chống trùng bằng hash.
// ════════════════════════════════════════════════════════════════════════════
model Evidence {
  id           String    @id @default(cuid())
  tenantId     String
  code         String // tự đánh mã: MC-0001
  title        String
  description  String?
  type         String? // loại minh chứng
  providerUnit String? // đơn vị cung cấp
  programmeId  String?
  academicYear String? // năm học áp dụng
  status       String    @default("pending") // pending | valid | needs_more | invalid
  note         String? // ghi chú kiểm tra
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files         EvidenceFile[]
  links         EvidenceLink[]
  criteria      EvidenceCriterionMapping[]
  requirements  EvidenceRequirementMapping[]
  verifications EvidenceVerificationLog[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, academicYear])
  @@index([tenantId, deletedAt])
  @@map("evidences")
}

model EvidenceFile {
  id          String   @id @default(cuid())
  tenantId    String
  evidenceId  String
  fileName    String
  storageKey  String // key trong lớp Storage (prefix theo tenant)
  size        Int
  contentType String?
  hash        String // sha256 để chống trùng
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, evidenceId])
  @@index([tenantId, hash]) // dò trùng theo hash trong tenant
  @@map("evidence_files")
}

model EvidenceLink {
  id         String   @id @default(cuid())
  tenantId   String
  evidenceId String
  url        String
  label      String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, evidenceId])
  @@map("evidence_links")
}

model EvidenceCriterionMapping {
  id          String   @id @default(cuid())
  tenantId    String
  evidenceId  String
  criterionId String // Criterion (global)
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, criterionId])
  @@index([tenantId, criterionId])
  @@map("evidence_criteria_mappings")
}

model EvidenceRequirementMapping {
  id            String   @id @default(cuid())
  tenantId      String
  evidenceId    String
  requirementId String
  createdAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, requirementId])
  @@index([tenantId, requirementId])
  @@map("evidence_requirement_mappings")
}

model EvidenceVerificationLog {
  id         String   @id @default(cuid())
  tenantId   String
  evidenceId String
  fromStatus String?
  toStatus   String
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, evidenceId])
  @@map("evidence_verification_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// P6 — Nhiệm vụ (Kanban/calendar) + Kế hoạch cải tiến PDCA (tenant-scoped)
// ════════════════════════════════════════════════════════════════════════════
model Task {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?
  type        String? // thu thập minh chứng | viết SAR | rà soát | ...
  status      String    @default("todo") // todo | in_progress | review | done
  priority    String    @default("normal") // low | normal | high
  assigneeId  String?
  sarId       String?
  criterionId String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments TaskComment[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  tenantId  String
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskId])
  @@map("task_comments")
}

model ImprovementPlan {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  criterionId String?
  issue       String? // vấn đề cần cải tiến
  cause       String? // nguyên nhân
  status      String    @default("open") // open | in_progress | done | cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actions ImprovementAction[]
  kpis    ImprovementKpi[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("improvement_plans")
}

model ImprovementAction {
  id              String    @id @default(cuid())
  tenantId        String
  planId          String
  action          String
  pdcaPhase       String    @default("plan") // plan | do | check | act
  responsibleUnit String?
  assigneeId      String?
  dueDate         DateTime?
  status          String    @default("pending") // pending | doing | done
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     ImprovementPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  progress ImprovementProgressLog[]

  @@index([tenantId, planId])
  @@map("improvement_actions")
}

model ImprovementKpi {
  id       String  @id @default(cuid())
  tenantId String
  planId   String
  name     String
  unit     String?
  target   Float?
  actual   Float?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   ImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, planId])
  @@map("improvement_kpis")
}

model ImprovementProgressLog {
  id        String   @id @default(cuid())
  tenantId  String
  actionId  String
  note      String
  percent   Int?
  actorId   String?
  createdAt DateTime @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action ImprovementAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([tenantId, actionId])
  @@map("improvement_progress_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// P7 — Xuất báo cáo qua background job (tenant-scoped). Tác vụ nặng đẩy sang job,
// có polling tiến độ; chế độ inline ở dev (JOB_MODE).
// ════════════════════════════════════════════════════════════════════════════
model ExportJob {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // sar_docx | sar_pdf | evidence_xlsx | evidence_zip
  params    Json?
  status    String   @default("pending") // pending | running | done | failed
  progress  Int      @default(0)
  resultKey String? // key file kết quả trong Storage
  fileName  String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("export_jobs")
}

// ════════════════════════════════════════════════════════════════════════════
// P8 — Lớp AI (tenant-scoped). AI là lớp service có kiểm soát: key mã hóa theo
// tenant, đo token/chi phí, hạn mức, human-in-the-loop (nội dung AI = nháp tới khi duyệt).
// ════════════════════════════════════════════════════════════════════════════
model AiSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  enabled         Boolean  @default(false)
  provider        String?  // openai | azure | gemini | claude | local
  baseUrl         String?
  model           String?
  apiKeyEnc       String?  // khóa API mã hóa (AES-256-GCM, có prefix phiên bản)
  dailyTokenLimit Int      @default(200000)
  enabledModules  Json?    // { summarize: true, draft: true, gap: true, ... }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AiRequest {
  id         String   @id @default(cuid())
  tenantId   String
  module     String   // summarize_evidence | draft_sar | gap_check | ...
  model      String?
  promptChars Int     @default(0)
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  costUsd    Float    @default(0)
  status     String   @default("ok") // ok | error
  error      String?
  actorId    String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@map("ai_requests")
}

model AiGeneratedDraft {
  id          String   @id @default(cuid())
  tenantId    String
  module      String   // draft_sar | summarize_evidence | ...
  targetType  String?  // SarCriterionResponse | Evidence | ...
  targetId    String?
  field       String?  // trường đích nếu áp dụng (vd: analysis, strengths)
  content     String   // nội dung do AI sinh (NHÁP)
  source      String   @default("ai") // luôn đánh dấu nguồn = ai
  status      String   @default("draft") // draft | approved | rejected
  approvedBy  String?
  approvedAt  DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, targetType, targetId])
  @@map("ai_generated_drafts")
}

// ════════════════════════════════════════════════════════════════════════════
// P9 — Khảo sát bên liên quan (tenant-scoped). Gắn khảo sát với tiêu chí; gửi link;
// thu thập + phân tích phản hồi.
// ════════════════════════════════════════════════════════════════════════════
model StakeholderGroup {
  id        String   @id @default(cuid())
  tenantId  String
  code      String // student | alumni | employer | lecturer | staff | partner
  name      String
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  surveys Survey[]

  @@unique([tenantId, code])
  @@map("stakeholder_groups")
}

model Survey {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?
  criterionId String? // gắn khảo sát với tiêu chí kiểm định
  groupId     String?
  status      String    @default("draft") // draft | open | closed
  token       String?   @unique // link công khai
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  deletedAt   DateTime?

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     StakeholderGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("surveys")
}

model SurveyQuestion {
  id       String  @id @default(cuid())
  tenantId String
  surveyId String
  order    Int     @default(1)
  text     String
  type     String  @default("rating") // rating | text | choice
  options  Json? // cho type=choice

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([tenantId, surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  tenantId  String
  surveyId  String
  respondent Json? // thông tin người trả lời (tùy chọn, ẩn danh được)
  answers   Json // { questionId: value }
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([tenantId, surveyId])
  @@map("survey_responses")
}

// ════════════════════════════════════════════════════════════════════════════
// Module dữ liệu kiểm định (tenant-scoped) phục vụ tiêu chí C5–C8 (đặc tả 4.9–4.12)
// ════════════════════════════════════════════════════════════════════════════
model AcademicStaff {
  id             String    @id @default(cuid())
  tenantId       String
  facultyId      String?
  fullName       String
  academicRank   String? // học hàm: GS/PGS
  degree         String? // học vị: TS/ThS/CN
  specialization String? // chuyên môn
  position       String?
  publications   Int       @default(0)
  note           String?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([tenantId, facultyId])
  @@map("academic_staff")
}

model StudentService {
  id           String    @id @default(cuid())
  tenantId     String
  category     String // admission | advising | scholarship | internship | career | extracurricular | support
  title        String
  description  String?
  academicYear String?
  metricValue  Float?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@map("student_services")
}

model Facility {
  id        String    @id @default(cuid())
  tenantId  String
  code      String?
  name      String
  type      String // classroom | lab | library | it | software | equipment | space
  quantity  Int?
  capacity  Int?
  location  String?
  note      String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
  @@map("facilities")
}

model OutcomeMetric {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  category     String // graduation | employment | satisfaction | plo_attainment | research | other
  academicYear String?
  value        Float?
  unit         String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, academicYear])
  @@index([tenantId, deletedAt])
  @@map("outcome_metrics")
}
