// Prisma schema — Hệ thống Kiểm định CTĐT (AUN-QA, đa tiêu chuẩn)
// Quy ước (xem CLAUDE.md):
//   - Mọi bảng nghiệp vụ có: id, tenantId, createdAt, updatedAt, createdBy,
//     updatedBy, status, deletedAt (soft-delete).
//   - Bảng nghiệp vụ phải nằm trong TENANT_SCOPED_MODELS ở
//     src/lib/prisma/tenant-models.ts để được lọc tenant tự động.
//   - Mỗi thay đổi schema = đúng một migration. Không sửa DB tay.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Registry tenant (KHÔNG tenant-scoped) ──────────────────────────────────
// Đăng ký các trường đại học dùng nền tảng. Billing theo thời gian: validUntil.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // subdomain: <slug>.localhost
  name      String
  status    String   @default("active") // active | suspended
  validUntil DateTime? // billing: hết hạn -> middleware chặn 403
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs   AuditLog[]
  users       User[]
  userRoles   UserRole[]
  faculties   Faculty[]
  departments Department[]

  @@map("tenants")
}

// ─── RBAC khai báo bằng dữ liệu (GLOBAL — không tenant-scoped) ───────────────
// Permission/Role là catalog dùng chung mọi tenant; assignment (UserRole) mới theo tenant.
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // ví dụ "user.manage", "sar.write"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ví dụ "qa_office", "lecturer"
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Người dùng (tenant-scoped) ─────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  isSuperAdmin Boolean   @default(false) // xuyên tenant (đường đi riêng)
  status       String    @default("active") // active | disabled
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime? // soft-delete

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  facultyId String? // phạm vi: vai trò gắn với khoa cụ thể (tùy chọn)
  createdAt DateTime @default(now())
  createdBy String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, facultyId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

// ─── Đơn vị (tenant-scoped) ─────────────────────────────────────────────────
model Faculty {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("faculties")
}

model Department {
  id        String    @id @default(cuid())
  tenantId  String
  facultyId String
  code      String
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, facultyId])
  @@index([tenantId, deletedAt])
  @@map("departments")
}

// ─── Audit log (tenant-scoped) ──────────────────────────────────────────────
// Ghi mọi thao tác quan trọng: tạo/sửa/xóa/duyệt/chấm điểm/thao tác AI.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String // ví dụ: "tenant.create", "sar.approve", "ai.draft"
  entity    String // tên thực thể: "Tenant", "SelfAssessmentReport", ...
  entityId  String?
  actorId   String? // user id thực hiện (null = hệ thống/seed)
  meta      Json? // dữ liệu phụ (diff, ghi chú...)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}
