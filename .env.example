# ─── Database ────────────────────────────────────────────────────────────────
# Production-like dev database (PostgreSQL — KHÔNG dùng SQLite, xem CLAUDE.md).
DATABASE_URL="postgresql://aiqms:aiqms@localhost:5432/aiqms?schema=public"
# Database riêng cho test (vitest sẽ migrate + chạy test trên đây).
TEST_DATABASE_URL="postgresql://aiqms:aiqms@localhost:5432/aiqms_test?schema=public"

# Pool (serverless: dùng pooler như PgBouncer/Prisma Accelerate ở prod).
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=10

# ─── Cờ cấu hình (bật/tắt nhanh khi sự cố) ───────────────────────────────────
RLS_ENABLED=false           # bật RLS Postgres sau cờ này (chạy pen-test RLS trước khi bật ở prod)
AI_ENABLED=false            # bật/tắt lớp AI toàn cục
JOB_MODE=inline             # inline (chạy ngay, tiện dev) | queue (BullMQ)
STORAGE_DRIVER=local        # local | s3

# ─── Multi-tenant ────────────────────────────────────────────────────────────
BASE_DOMAIN=localhost       # phân giải tenant theo subdomain <truong>.localhost
DEFAULT_TENANT_SLUG=demo    # tenant mặc định khi không xác định được (dev)

# ─── Bảo mật ─────────────────────────────────────────────────────────────────
JWT_SECRET="dev-only-change-me-please-32bytes-min"        # >= 32 ký tự
ENCRYPTION_KEY="dev-only-32-byte-key-base64-aaaaaaaa="    # 32 bytes base64, để mã hóa khóa AI theo tenant
CORS_ORIGIN_REGEX="^https?://([a-z0-9-]+\\.)?localhost(:\\d+)?$"

# ─── Storage (khi STORAGE_DRIVER=local) ──────────────────────────────────────
STORAGE_LOCAL_DIR=.storage

# ─── Storage (khi STORAGE_DRIVER=s3) ─────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI (khi AI_ENABLED=true) — cấu hình mặc định, có thể override theo tenant ─
AI_PROVIDER=openai          # openai | azure | gemini | claude | local (OpenAI-compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=200000 # hạn mức token/ngày theo tenant (mặc định)
AI_MAX_CONCURRENCY=4

# ─── Seed (idempotent bootstrap super-admin) ─────────────────────────────────
SYSTEM_TENANT_SLUG=system
SUPERADMIN_EMAIL=superadmin@aiqms.local
SUPERADMIN_PASSWORD=ChangeMe123!          # ĐỔI ở prod
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Demo1234!
